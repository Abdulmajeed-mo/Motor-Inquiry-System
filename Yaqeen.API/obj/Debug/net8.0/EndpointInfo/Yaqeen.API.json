{
  "openapi": "3.0.1",
  "info": {
    "title": "Yaqeen.API",
    "version": "1.0"
  },
  "paths": {
    "/api/yaqeen/citizen/validate": {
      "post": {
        "tags": [
          "Citizen"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CitizenValidationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CitizenValidationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CitizenValidationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/yaqeen/vehicle/sequence/{sequenceNumber}": {
      "get": {
        "tags": [
          "Vehicle"
        ],
        "parameters": [
          {
            "name": "sequenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/yaqeen/vehicle/plate": {
      "get": {
        "tags": [
          "Vehicle"
        ],
        "parameters": [
          {
            "name": "plateNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "plateLetters",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CitizenValidationRequest": {
        "type": "object",
        "properties": {
          "nationalId": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  }
}