{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },

  "RateLimit": {
    "PermitLimit": 5,
    "WindowMinutes": 1,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}